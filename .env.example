# Copy to .env and change every "change-me" value before deploying.

# Postgres — external RDS instance, not a container in this compose file.
# Get the endpoint from the RDS console; security group must allow inbound
# 5432 from the EC2 instance's own security group only.
DATABASE_URL=postgres://kokoon:change-me-rds-password@your-instance.xxxxxxxxxx.us-east-1.rds.amazonaws.com:5432/kokoon

# Backend services (ingestion + ws)
REDIS_URL=redis://redis:6379
MQTT_URL=mqtt://mosquitto:1883

# MQTT credentials for backend services (ingestion subscription, ws snapshot publishes).
# Treated as a superuser by the broker auth — never give these to a device.
MQTT_BACKEND_USER=kokoon-backend
MQTT_BACKEND_PASS=change-me-backend-mqtt

# Auth
JWT_SECRET=change-me-jwt-secret

# Host port the ws cluster is published on (browser + CodeLab + device provisioning)
WS_PORT=8080

# 0 = one ws worker per CPU core
WS_WORKERS=0

# Optional: terminate TLS inside the ws workers (paths inside the container).
# Leave unset to serve plain HTTP (e.g. behind a TLS-terminating proxy).
# TLS_CERT_FILE=
# TLS_KEY_FILE=

HISTORY_RETENTION_DAYS=30
